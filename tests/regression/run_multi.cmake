# Running several [[run]]s in one process, or in parallel with --jobs, must give the same
# output as running each in its own process. Inputs: SIM, CONFIG, WORK_DIR.
file(REMOVE_RECURSE ${WORK_DIR})

execute_process(COMMAND ${SIM} ${CONFIG} --data-dir ${WORK_DIR}/all RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "combined run failed (${rc})")
endif()
execute_process(COMMAND ${SIM} ${CONFIG} --data-dir ${WORK_DIR}/par --jobs 2 RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "parallel run failed (${rc})")
endif()
foreach(pair "small;closed_200_2.50_4_4_200_mu3_0.000_mu8_0.000" "larger;closed_200_5.00_8_4_400_mu3_0.000_mu8_0.000")
  list(GET pair 0 name)
  list(GET pair 1 folder)
  execute_process(COMMAND ${SIM} ${CONFIG} --only ${name} --data-dir ${WORK_DIR}/${name}
                  RESULT_VARIABLE rc OUTPUT_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "run '${name}' failed (${rc})")
  endif()
  foreach(kind M C)
    file(GLOB b ${WORK_DIR}/${name}/${folder}/${kind}_*.dat)
    foreach(mode all par)
      file(GLOB a ${WORK_DIR}/${mode}/${folder}/${kind}_*.dat)
      execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${a} ${b} RESULT_VARIABLE differs)
      if(differs)
        message(FATAL_ERROR "${name}: ${kind}_ file from the '${mode}' run differs from the separate run")
      endif()
    endforeach()
  endforeach()
  file(GLOB logs ${WORK_DIR}/par/${folder}/log_*.txt)
  list(LENGTH logs n)
  if(NOT n EQUAL 1 OR logs MATCHES "running")
    message(FATAL_ERROR "${name}: expected one finished log_*.txt from the parallel run, found '${logs}'")
  endif()
  file(GLOB logs ${WORK_DIR}/all/${folder}/log_*)
  if(logs)
    message(FATAL_ERROR "${name}: a sequential run wrote a log file")
  endif()
endforeach()
